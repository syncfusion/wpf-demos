<democommon:DemoControl
    x:Class="syncfusion.datagriddemos.wpf.ResizingDemo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:democommon="clr-namespace:syncfusion.demoscommon.wpf;assembly=syncfusion.demoscommon.wpf"
    xmlns:local="clr-namespace:syncfusion.datagriddemos.wpf"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
    DataContext="{DynamicResource employeeInfoViewModel}"
    syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
    Background="#FFFFFF"
    OptionsSize="250"
>


    <democommon:DemoControl.Resources>
        <local:EmployeeInfoViewModel x:Key="employeeInfoViewModel" />
    </democommon:DemoControl.Resources>

    <democommon:DemoControl.Options>
        <StackPanel Margin="5">
            <TextBlock
                Margin="5"
                FontWeight="Bold"
                Text="Resizing Columns Options" />

            <CheckBox
                x:Name="chkAllowResizingColumns"
                Margin="5"
                Content="Allow Resizing Columns"
                IsChecked="True" />

            <CheckBox
                x:Name="chkAllowResizingHiddenColumns"
                Margin="5"
                Content="Allow Resizing Hidden Columns"
                IsChecked="True" />

            <TextBlock
                Margin="5"
                FontWeight="Bold"
                Text="Resizing Rows Options" />

            <CheckBox
                x:Name="chkAllowResizingRows"
                Margin="5"
                Content="Allow Resizing Rows"
                IsChecked="True" />

            <CheckBox
                x:Name="chkAllowResizingHiddenRows"
                Margin="5"
                Content="Allow Resizing Hidden Rows"
                IsChecked="True" />
        </StackPanel>
    </democommon:DemoControl.Options>

    <Grid>

        <syncfusion:SfDataGrid
            x:Name="sfDataGrid"
            Margin="5"
            AllowResizingColumns="{Binding ElementName=chkAllowResizingColumns, Path=IsChecked, Mode=TwoWay}"
            AllowResizingHiddenColumns="{Binding ElementName=chkAllowResizingHiddenColumns, Path=IsChecked, Mode=TwoWay}"
            AllowResizingHiddenRows="{Binding ElementName=chkAllowResizingHiddenRows, Path=IsChecked, Mode=TwoWay}"
            AllowResizingRows="{Binding ElementName=chkAllowResizingRows, Path=IsChecked, Mode=TwoWay}"
            AutoGenerateColumns="False"
            ColumnSizer="Star"
            ItemsSource="{Binding Employees}"
            NavigationMode="Cell"
            GridLinesVisibility="Both"
            >

            <syncfusion:SfDataGrid.Columns>

                <syncfusion:GridNumericColumn
                    HeaderText="Employee ID"
                    MappingName="EmployeeID"
                    NumberDecimalDigits="0" Width="90"/>
                <syncfusion:GridTextColumn HeaderText="Employee Name" MappingName="Name" Width="150"/>
                <syncfusion:GridTextColumn HeaderText="Designation" MappingName="Title" Width="180"/>
                <syncfusion:GridTextColumn HeaderText="Gender" MappingName="Gender" Width="80"/>

                <syncfusion:GridNumericColumn HeaderText="Rating" MappingName="Rating" Width="90" NumberDecimalDigits="0"/>
                <syncfusion:GridNumericColumn HeaderText="Contact ID" MappingName="ContactID" NumberDecimalDigits="0" Width="90"/>
                <syncfusion:GridNumericColumn
                    HeaderText="Sick Leave Hours"
                    MappingName="SickLeaveHours" Width="110" NumberDecimalDigits="0"/>
                <syncfusion:GridCurrencyColumn
                    HeaderText="Salary"
                    CurrencyDecimalDigits="2"
                    MappingName="Salary" Width="100"/>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
    </Grid>
</democommon:DemoControl>