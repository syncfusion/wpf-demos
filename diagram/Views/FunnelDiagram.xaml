<democommon:DemoControl  
    xmlns:democommon="clr-namespace:syncfusion.demoscommon.wpf;assembly=syncfusion.demoscommon.wpf"   x:Class="syncfusion.diagramdemo.wpf.Views.FunnelDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:local="clr-namespace:syncfusion.diagramdemo.wpf.Views" xmlns:viewmodel="clr-namespace:syncfusion.diagramdemo.wpf.ViewModel"
    mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <democommon:DemoControl.DataContext>
        <viewmodel:FunnelDiagramViewModel/>
    </democommon:DemoControl.DataContext>
    <democommon:DemoControl.Resources>
        <local:StringToGeometryConverter x:Key="StringToGeometryConverter"/>
        <local:NullToVisibilityConverter  x:Key="NullToVisibilityConverter"/>
        <local:StringToSolidBrushConverter x:Key="StringToSolidBrushConverter"/>

        <DataTemplate x:Key="TooltipTemplate" DataType="{x:Type viewmodel:FunnelTooltipModel}">
            <Border Background="#1F2937" CornerRadius="8"
             Padding="12" MinWidth="200" MaxWidth="260"
             Effect="{DynamicResource TooltipShadow}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Width="35" Height="38" CornerRadius="16"
                         Background="{Binding Color,
                             Converter={StaticResource StringToSolidBrushConverter}}"
                         Margin="0,0,10,0">
                            <Viewbox Width="26" Height="30" Stretch="Uniform">
                                <Path Data="{Binding Path=IconText,
        Converter={StaticResource StringToGeometryConverter}}"
    Fill="White"
    Stretch="Uniform"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="{Binding Label}"
                            Foreground="White" FontFamily="Segoe UI"
                            FontSize="15" FontWeight="SemiBold"
                            VerticalAlignment="Center"/>
                    </StackPanel>

                    <Separator Background="#4B5563" Margin="0,0,0,8"/>

                    <Grid Margin="0,0,0,6"
                   Visibility="{Binding ConversionText,
                       Converter={StaticResource NullToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Conversion" Foreground="#9CA3AF"
                            FontFamily="Segoe UI" FontSize="13"/>
                        <TextBlock Text="{Binding ConversionText}"
                            Foreground="White" FontFamily="Segoe UI"
                            FontSize="13" FontWeight="Bold" Grid.Column="1"/>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Cumulative" Foreground="#9CA3AF"
                            FontFamily="Segoe UI" FontSize="13"/>
                        <TextBlock Text="{Binding CumulativeText}"
                            Foreground="White" FontFamily="Segoe UI"
                            FontSize="13" FontWeight="Bold" Grid.Column="1"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DropShadowEffect x:Key="TooltipShadow"
                   Color="Black" BlurRadius="12"
                   ShadowDepth="3" Opacity="0.4"/>
        <DataTemplate x:Key="TitleMainTemplate">
            <TextBlock Text="{Binding Path=Content, Mode=TwoWay}"
               FontFamily="Segoe UI" FontSize="22"
               FontWeight="Bold" Foreground="#111827"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextWrapping="NoWrap"/>
        </DataTemplate>

        <DataTemplate x:Key="TitleSubTemplate">
            <TextBlock Text="{Binding Path=Content, Mode=TwoWay}"
               FontFamily="Segoe UI" FontSize="14"
               Foreground="#6B7280"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextWrapping="NoWrap"/>
        </DataTemplate>

        <DataTemplate x:Key="SegmentValueTemplate">
            <TextBlock Text="{Binding Path=Content, Mode=TwoWay}"
               FontFamily="Segoe UI" FontSize="18"
               FontWeight="Bold" Foreground="#FFFFFF"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               TextWrapping="NoWrap"/>
        </DataTemplate>

        <DataTemplate x:Key="IconGlyphTemplate">
            <Viewbox Width="26" Height="26" Stretch="Uniform">
                <Path Data="{Binding Path=Content,
                  Converter={StaticResource StringToGeometryConverter}}"
              Fill="White"
              Stretch="Uniform"/>
            </Viewbox>
        </DataTemplate>

        <DataTemplate x:Key="StageLabelTemplate">
            <TextBlock Text="{Binding Path=Content, Mode=TwoWay}"
               FontFamily="Segoe UI" FontSize="16" 
               Foreground="#374151"
               HorizontalAlignment="Right"
               VerticalAlignment="Center"
               TextWrapping="NoWrap"/>
        </DataTemplate>
    </democommon:DemoControl.Resources>
        <Grid>
        <syncfusion:SfDiagram x:Name="Diagram" PortVisibility="Collapse" Tool="ZoomPan"
                       Nodes="{Binding Nodes}"
                       Connectors="{Binding Connectors}"
                       SnapSettings="{Binding SnapSettings}"
                       Background="White"
                       Loaded="Diagram_Loaded"
                       MouseMove="Diagram_MouseMove"
                       MouseLeave="Diagram_MouseLeave"/>

        <!-- ✅ PlacementMode.Relative + manual offset = smooth tracking -->
        <Popup x:Name="NodeTooltipPopup"
        AllowsTransparency="True"
        StaysOpen="True"
        IsOpen="False"
        PlacementTarget="{Binding ElementName=Diagram}"
        Placement="Relative"
        PopupAnimation="None">
            <ContentPresenter x:Name="TooltipContent"/>
        </Popup>
    </Grid>
</democommon:DemoControl>
