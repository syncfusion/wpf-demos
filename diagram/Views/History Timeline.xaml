<democommon:DemoControl x:Class="syncfusion.diagramdemo.wpf.Views.History_Timeline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:democommon="clr-namespace:syncfusion.demoscommon.wpf;assembly=syncfusion.demoscommon.wpf"   
             xmlns:model="clr-namespace:syncfusion.diagramdemo.wpf.Model"
             xmlns:local="clr-namespace:syncfusion.diagramdemo.wpf.Views"
             xmlns:viewmodel="clr-namespace:syncfusion.diagramdemo.wpf.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <democommon:DemoControl.DataContext>
        <viewmodel:HistoryTimelineViewModel/>
    </democommon:DemoControl.DataContext>
    <democommon:DemoControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Syncfusion.SfDiagram.WPF;component/Resources/BasicShapes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <local:NullOrEmptyToBoolConverter x:Key="NullOrEmptyToBoolConverter"/>
            <BooleanToVisibilityConverter    x:Key="BoolToVisibility"/>
            <SolidColorBrush x:Key="PathStrokeThemeBrush" Color="#FFFFFFFF" />

            <DataTemplate x:Key="TimelineLineTemplate">
                <Border Height="10" CornerRadius="5"
             Background="{Binding DynamicBrush}"/>
            </DataTemplate>

            <!-- ══════════════════════════════════════════════════════
      STEP 2 — DataTemplates (converters already declared above)
      ══════════════════════════════════════════════════════ -->
            <Style TargetType="syncfusion:QuickCommand">
                <Setter Property="ShapeStyle">
                    <Setter.Value>
                        <Style TargetType="Path" x:Name="Style">
                            <Setter Property="Fill"  Value="#434343"/>
                            <Setter Property="Stretch" Value="Fill"/>
                            <Setter Property="Stroke" Value="#FFFFFF"/>
                            <Setter Property="StrokeThickness" Value="1"/>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Event card — mirrors JS getEventNodeTemplate() -->
            <DataTemplate x:Key="EventNodeTemplate">
                <Border Background="{Binding EventBrush}"
             CornerRadius="5"
             Width="130" Height="100">
                    <Border.ToolTip>
                        <ToolTip Background="Transparent" BorderBrush="Transparent">
                            <Border Background="#1A1A1A" CornerRadius="6" Padding="12,8" MaxWidth="280">
                                <TextBlock Text="{Binding TooltipText}"
                                Foreground="White" FontSize="12"
                                FontFamily="Segoe UI" TextWrapping="Wrap"/>
                            </Border>
                        </ToolTip>
                    </Border.ToolTip>

                    <StackPanel VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     Margin="5">

                        <!-- Image — visible only when ImageUrl is set -->
                        <Image MaxHeight="50" MaxWidth="110" Margin="0,0,0,4" Stretch="Uniform">
                            <Image.Source>
                                <Binding Path="ImageUrl"/>
                            </Image.Source>
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImageUrl,
                                          Converter={StaticResource NullOrEmptyToBoolConverter},
                                          ConverterParameter=Visibility}"
                                          Value="Visible">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!-- Fix: Path icon — replaces Segoe MDL2 TextBlock
                  Uses IconPath (SVG path data) instead of IconUnicode -->
                        <Viewbox Width="32" Height="32" Margin="0,0,0,4">
                            <Viewbox.Style>
                                <Style TargetType="Viewbox">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ImageUrl,
                                          Converter={StaticResource NullOrEmptyToBoolConverter},
                                          ConverterParameter=Visibility}"
                                          Value="Visible">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Viewbox.Style>
                            <Path Data="{Binding IconPath}"
                       Fill="#333333"
                       Stretch="Uniform"/>
                        </Viewbox>

                        <!-- Title -->
                        <TextBlock Text="{Binding Title}"
                        FontSize="11" FontWeight="Bold"
                        Foreground="#333333"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

          
            <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="BorderBrush" Value="#BDBDBD"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3">
                                <Grid>
                                    <TextBlock x:Name="PlaceholderText"
                                               Text="{TemplateBinding Tag}"
                                               Foreground="#AAAAAA"
                                               FontSize="{TemplateBinding FontSize}"
                                               Margin="{TemplateBinding Padding}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed"/>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Text" Value=""/>
                                        <Condition Property="IsFocused" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="PlaceholderText"
                                            Property="Visibility" Value="Visible"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- Year circle — mirrors JS getYearNodeTemplate() -->
            <DataTemplate x:Key="YearMarkerTemplate">
                <Grid Width="50" Height="50">
                    <Ellipse Fill="#333333"/>
                    <TextBlock Text="{Binding Year}"
                    Foreground="White" FontSize="11"
                    FontFamily="Segoe UI"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
                </Grid>
            </DataTemplate>

            <Style x:Key="NullType" TargetType="{x:Type syncfusion:DiagramThumb}">
                <Setter Property="Template" Value="{x:Null}"/>
            </Style>
            <Style x:Key="TopLeftCornerResizerThumpTemplate" TargetType="{x:Type syncfusion:DiagramThumb}">
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="Background" Value="Blue"/>
                <Setter Property="Width" Value="25"/>
                <Setter Property="Height" Value="25"/>
                <Setter Property="Margin" Value="0 -5 0 0"/>
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type syncfusion:DiagramThumb}">
                            <Grid >
                                <Rectangle Fill="Transparent"/>

                                <Border   Height="2" HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
       						VerticalAlignment="{TemplateBinding VerticalAlignment}"  Margin="0 -3 0 0"
       						x:Name="PART_ReseizerThumb" CornerRadius="7" 
       						Background="{TemplateBinding Background}"
       						BorderBrush="{TemplateBinding BorderBrush}"
       						BorderThickness="0" />
                                <Rectangle  x:Name="PART_ResizerBorder" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
       						VerticalAlignment="{TemplateBinding VerticalAlignment}" Fill="Blue" Stroke="Blue"  StrokeThickness="1"
       						Margin="7"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style TargetType="{x:Type syncfusion:Selector}" x:Key="CustomSelectorStyle">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border
       					Background="{TemplateBinding Background}"
       					BorderBrush="{TemplateBinding BorderBrush}"
       					BorderThickness="{TemplateBinding BorderThickness}">
                                <syncfusion:SelectorPanel>
                                    <syncfusion:SelectorPanel.Resources>
                                        <Style x:Key="pathStyle" TargetType="{x:Type Shape}">
                                            <Setter Property="StrokeThickness" Value="1"/>
                                            <Setter Property="Stroke" Value="Transparent"/>
                                        </Style>
                                    </syncfusion:SelectorPanel.Resources>
                                    <Rectangle Style="{StaticResource pathStyle}" Stretch="Fill" StrokeDashArray="2, 2"/>
                                    <Line X1="0" X2="0" Y1="0" Y2="0" StrokeThickness="0" Visibility="Collapsed" StrokeDashArray="2, 2" Style="{StaticResource pathStyle}"/>
                                    <syncfusion:DiagramThumb x:Name="PART_TopLeft"  ControlPointType="TopLeftResizer"
       							Style="{StaticResource NullType}"
       							HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <syncfusion:DiagramThumb x:Name="PART_Top" ControlPointType="TopResizer"
       							Style="{StaticResource NullType}"
       							HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <syncfusion:DiagramThumb x:Name="PART_TopRight" ControlPointType="TopRightResizer"
       							Style="{StaticResource NullType}"
       							HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                    <syncfusion:DiagramThumb x:Name="PART_Left" ControlPointType="LeftResizer"
       							Style="{StaticResource NullType}"
       							HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <syncfusion:DiagramThumb x:Name="PART_Right" ControlPointType="RightResizer"
       							Style="{StaticResource NullType}"
       							HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <syncfusion:DiagramThumb x:Name="PART_BottomLeft" ControlPointType="BottomLeftResizer"
       							Style="{StaticResource NullType}"
       							HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <syncfusion:DiagramThumb x:Name="PART_Bottom"  ControlPointType="BottomResizer"
       							Style="{StaticResource NullType}"
       							HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                    <syncfusion:DiagramThumb x:Name="PART_BottomRight" ControlPointType="BottomRightResizer"
       							Style="{StaticResource NullType}"
       							HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

                                    <syncfusion:DiagramThumb Width="0" Height="0" Visibility="Collapsed" ControlPointType="Pivot" x:Name="PART_Pivot"/>
                                    <syncfusion:DiagramThumb Width="0" Height="0" Visibility="Collapsed" ControlPointType="Rotator" x:Name="PART_Rotator"/>
                                </syncfusion:SelectorPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </democommon:DemoControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Height="80" Background="#F5F5F5" Margin="0,0,0,0">
            <TextBlock Text="Internet History Timeline"
                    FontSize="28" FontWeight="Bold"
                    FontFamily="Segoe UI"
                    HorizontalAlignment="Center"
                    Foreground="#1A1A1A"/>
            <TextBlock Text="A comprehensive timeline of key events in Internet development from 1969 to 2035"
                    FontSize="13" FontFamily="Segoe UI"
                    Foreground="#666666"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Diagram -->
        <Border Grid.Row="1"  Background="White"
             CornerRadius="8" BorderBrush="#E0E0E0" BorderThickness="1">
            <local:HistoryDiagram x:Name="Diagram" 
                               Nodes="{Binding DiagramNodes}"
                               Connectors="{Binding DiagramConnectors}">
                <syncfusion:SfDiagram.SnapSettings>
                    <syncfusion:SnapSettings SnapConstraints="None"/>
                </syncfusion:SfDiagram.SnapSettings>

                <!-- Quick commands — mirrors JS userHandles -->
                <syncfusion:SfDiagram.SelectedItems>
                    <syncfusion:SelectorViewModel Constraints="None">
                        <syncfusion:SelectorViewModel.Commands>
                            <syncfusion:QuickCommandCollection>
                                <!-- + Add Event — mirrors JS 'New Event' handle -->
                                <syncfusion:QuickCommandViewModel
                                 x:Name="AddEventCommand"
                                 OffsetX="2.25" OffsetY="0.5"
                                   Shape="{StaticResource Ellipse}" 
                                
                                 Content="M12.099998,0L19.799995,0 19.799995,12.1 32,12.1 32,19.799996 19.900002,19.799996 19.900002,31.999999 12.199997,31.999999 12.199997,19.900003 0,19.900003 0,12.199999 12.099998,12.199999z"
                                />
                                <!-- Pencil — mirrors JS 'Edit Event' handle -->
                                <syncfusion:QuickCommandViewModel
                                 x:Name="EditEventCommand"
                                 OffsetX="0.5" OffsetY="1.5"
                                Shape="{StaticResource Ellipse}" 
                                
                                 Content="M20.638062,9.6380005L6.6380615,23.638 8.3620605,25.362 22.362061,11.362z M20.5,4.5L27.5,11.5 9,30 0,32 2,23z M27,0C29.760986,0 32,2.2389832 32,5 32,6.1259766 31.628052,7.1640015 31,8L29,10 22,3 24,1C24.83606,0.37197876,25.874023,0,27,0z"
                                 />
                            </syncfusion:QuickCommandCollection>
                        </syncfusion:SelectorViewModel.Commands>
                    </syncfusion:SelectorViewModel>
                </syncfusion:SfDiagram.SelectedItems>

            </local:HistoryDiagram>
        </Border>



        <Grid Grid.Row="1"
              Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVisibility}}"
              Background="#66000000">
            <ContentControl>
                <ContentControl.Resources>
                    <ResourceDictionary>
                        <!-- Override TextBox style — prevents theme from restyling it -->
                        <Style TargetType="TextBox"
                               BasedOn="{StaticResource PlaceholderTextBoxStyle}">
                            <Setter Property="Background"  Value="White"/>
                            <Setter Property="Foreground"  Value="#212121"/>
                            <Setter Property="BorderBrush" Value="#BDBDBD"/>
                        </Style>

                        <!-- Override Button style — keeps custom look regardless of theme -->
                        <Style TargetType="Button">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Cursor"          Value="Hand"/>
                            <Setter Property="FontSize"        Value="13"/>
                            <Setter Property="FontFamily"      Value="Segoe UI"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Override TextBlock — prevents theme font/color changes -->
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Segoe UI"/>
                            <Setter Property="Foreground" Value="#212121"/>
                        </Style>
                    </ResourceDictionary>
                </ContentControl.Resources>

                <Border Width="340" MaxHeight="520"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        CornerRadius="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="4"
                                          Direction="270" Color="#000000" Opacity="0.25"/>
                    </Border.Effect>

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,16">

                            <TextBlock Text="{Binding DialogTitle}"
                                       FontSize="16" FontWeight="SemiBold"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Year:" FontSize="12" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding DialogYear, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="e.g., 2025" Margin="0,0,0,8"/>

                            <TextBlock Text="Title:" FontSize="12" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding DialogEventTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Event Title" Margin="0,0,0,8"/>

                            <TextBlock Text="Description:" FontSize="12" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding DialogDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Brief description of the event"
                                     TextWrapping="Wrap" AcceptsReturn="True"
                                     Height="60" VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,8"/>

                            <TextBlock Text="Image Url:" FontSize="12" Margin="0,0,0,2"/>
                            <TextBox Text="{Binding DialogImageUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="https://example.com/image.jpg"
                                     Margin="0,0,0,8"/>

                            <!-- Validation error -->
                            <TextBlock Text="{Binding YearValidationError}"
                                       Foreground="#D32F2F" FontSize="11"
                                       TextWrapping="Wrap" Margin="0,0,0,6"
                                       Visibility="{Binding YearValidationError,
                                                    Converter={StaticResource NullOrEmptyToBoolConverter},
                                                    ConverterParameter=Visibility}"/>

                            <!-- Buttons -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Margin="0,4,0,0">
                                <Button Content="Submit"
                                        Command="{Binding SubmitDialogCommand}"
                                        Background="#1565C0" Foreground="White"
                                        Padding="18,7" Margin="0,0,8,0"/>
                                <Button Content="Cancel"
                                        Command="{Binding CancelDialogCommand}"
                                        Background="#9E9E9E" Foreground="White"
                                        Padding="18,7"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </ContentControl>
        </Grid>

    </Grid>
</democommon:DemoControl>
