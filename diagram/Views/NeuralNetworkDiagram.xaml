                        <TextBlock Text="Neuron Information" Foreground="White"
                                  FontWeight="Bold" FontSize="13" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <Separator Background="#444" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Layer: " Foreground="White"
                                  FontWeight="Bold" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding LayerName}" Foreground="White"
                                  FontSize="12" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Neuron: " Foreground="White"
                                  FontWeight="Bold" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding NeuronName}" Foreground="White"
                                  FontSize="12" FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Connector tooltip -->
        <DataTemplate x:Key="ConnectorTooltipTemplate"
                     DataType="{x:Type viewmodel:ConnectionTooltipInfo}">
            <Border Background="#1a1a2e" CornerRadius="6"
                   Padding="10,8" MinWidth="170"
                   Effect="{StaticResource TooltipShadow}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="🔗" FontSize="12" Background="Black" Foreground="White"
                                  VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Connection Details" Foreground="White"
                                  FontWeight="Bold" FontSize="13" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <Separator Background="#444" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="Weight: " Foreground="White"
                                  FontWeight="Bold" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding Weight}"
                                  FontWeight="Bold" FontSize="12" FontFamily="Segoe UI">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#2ecc71"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPositive}" Value="False">
                                            <Setter Property="Foreground" Value="#e74c3c"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <TextBlock Text="From: " Foreground="White"
                                  FontWeight="Bold" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding FromNode}" Foreground="White"
                                  FontSize="12" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="To: " Foreground="White"
                                  FontWeight="Bold" FontSize="12" FontFamily="Segoe UI"/>
                        <TextBlock Text="{Binding ToNode}" Foreground="White"
                                  FontSize="12" FontFamily="Segoe UI"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

    </democommon:DemoControl.Resources>

    <Grid>

        <!-- ── SfDiagram fills entire window ── -->
        <syncfusion:SfDiagram x:Name="Diagram"
                             Background="White"
                             Nodes="{Binding Nodes}"
                             Connectors="{Binding Connectors}"
                             Loaded="Diagram_Loaded"
                             MouseMove="Diagram_MouseMove"
                             MouseLeave="Diagram_MouseLeave">

            <syncfusion:SfDiagram.SnapSettings>
                <syncfusion:SnapSettings SnapConstraints="None"/>
            </syncfusion:SfDiagram.SnapSettings>

            <syncfusion:SfDiagram.Tool>ZoomPan</syncfusion:SfDiagram.Tool>
            <syncfusion:SfDiagram.PageSettings>
                <syncfusion:PageSettings PageBackground="White"
                                        PageBorderThickness="0"/>
            </syncfusion:SfDiagram.PageSettings>

            <syncfusion:SfDiagram.ScrollSettings>
                <syncfusion:ScrollSettings ScrollLimit="Infinity"/>
            </syncfusion:SfDiagram.ScrollSettings>

        </syncfusion:SfDiagram>

        <!-- Tooltip popup — follows mouse, never blocks interaction -->
        <Popup x:Name="DiagramTooltipPopup"
              AllowsTransparency="True"
              IsOpen="False"
              IsHitTestVisible="False"
              PlacementTarget="{Binding ElementName=Diagram}"
              Placement="Relative">
            <ContentControl x:Name="TooltipContent"/>
        </Popup>

    </Grid>
</democommon:DemoControl>
