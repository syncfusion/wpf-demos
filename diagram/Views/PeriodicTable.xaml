<democommon:DemoControl x:Class=" syncfusion.diagramdemo.wpf.Views.PeriodicTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
xmlns:democommon="clr-namespace:syncfusion.demoscommon.wpf;assembly=syncfusion.demoscommon.wpf"    
xmlns:viewmodel="clr-namespace:syncfusion.diagramdemo.wpf.ViewModel"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:syncfusion.diagramdemo.wpf.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <democommon:DemoControl.Resources>
        <!-- Original converters -->
            <local:CategoryToColorConverter  x:Key="CategoryToColor"/>
            <local:BoolToVisibilityConverter x:Key="BoolToVis"/>

            <!-- ✅ NEW: Converter for Group/Period highlight blur -->
            <local:BoolToOpacityConverter    x:Key="BlurToOpacity"/>

            <SolidColorBrush x:Key="PathStrokeThemeBrush" Color="#FFFFFFFF" />

            <DataTemplate x:Key="UnifiedNodeTemplate">
                <Border x:Name="TileBorder"
                CornerRadius="5"
                Background="{Binding CategoryText,
                             Converter={StaticResource CategoryToColor}}"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">

                    <!-- ✅ Replace Opacity binding with DataTrigger — more reliable in WPF -->
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="1.0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBlurred}" Value="True">
                                    <Setter Property="Opacity" Value="0.15"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="TileScale" ScaleX="1" ScaleY="1"/>
                    </Border.RenderTransform>

                    <Border.Effect>
                        <DropShadowEffect x:Name="TileShadow"
                                  BlurRadius="0" ShadowDepth="0"
                                  Color="Black" Opacity="0"/>
                    </Border.Effect>

                    <Grid Margin="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="13"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Text="{Binding AtomicNumberText}"
                               FontSize="9" FontFamily="Segoe UI"
                               Foreground="White" FontWeight="SemiBold"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Margin="2,0,0,0"/>
                            <TextBlock Text="{Binding AtomicMassText}"
                               FontSize="9" FontFamily="Segoe UI"
                               Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,0,2,0"
                               Visibility="{Binding IsHovered,
                                            Converter={StaticResource BoolToVis}}"/>
                        </Grid>

                        <TextBlock Grid.Row="1"
                           Text="{Binding SymbolText}"
                           FontSize="15" FontWeight="Bold"
                           FontFamily="Segoe UI" Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                        <TextBlock Grid.Row="2"
                           Text="{Binding NameText}"
                           FontSize="10" FontFamily="Segoe UI"
                           Foreground="White" FontWeight="Light"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           TextTrimming="CharacterEllipsis"
                           Margin="2,0,2,1"/>
                    </Grid>

                    <Border.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="TileScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1.28" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetName="TileScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1.28" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetName="TileShadow"
                                             Storyboard.TargetProperty="BlurRadius"
                                             To="14" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetName="TileShadow"
                                             Storyboard.TargetProperty="ShadowDepth"
                                             To="5" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetName="TileShadow"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0.55" Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="TileScale"
                                             Storyboard.TargetProperty="ScaleX"
                                             To="1" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetName="TileScale"
                                             Storyboard.TargetProperty="ScaleY"
                                             To="1" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetName="TileShadow"
                                             Storyboard.TargetProperty="BlurRadius"
                                             To="0" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetName="TileShadow"
                                             Storyboard.TargetProperty="ShadowDepth"
                                             To="0" Duration="0:0:0.12"/>
                                    <DoubleAnimation Storyboard.TargetName="TileShadow"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.12"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                </Border>
            </DataTemplate>


            <Style x:Key="NullType" TargetType="{x:Type syncfusion:DiagramThumb}">
                <Setter Property="Template" Value="{x:Null}"/>
            </Style>
            <Style x:Key="TopLeftCornerResizerThumpTemplate" TargetType="{x:Type syncfusion:DiagramThumb}">
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="Background" Value="Blue"/>
                <Setter Property="Width" Value="25"/>
                <Setter Property="Height" Value="25"/>
                <Setter Property="Margin" Value="0 -5 0 0"/>
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type syncfusion:DiagramThumb}">
                            <Grid >
                                <Rectangle Fill="Transparent"/>

                                <Border   Height="2" HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
         						VerticalAlignment="{TemplateBinding VerticalAlignment}"  Margin="0 -3 0 0"
         						x:Name="PART_ReseizerThumb" CornerRadius="7" 
         						Background="{TemplateBinding Background}"
         						BorderBrush="{TemplateBinding BorderBrush}"
         						BorderThickness="0" />
                                <Rectangle  x:Name="PART_ResizerBorder" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
         						VerticalAlignment="{TemplateBinding VerticalAlignment}" Fill="Blue" Stroke="Blue"  StrokeThickness="1"
         						Margin="7"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style TargetType="{x:Type syncfusion:Selector}" x:Key="CustomSelectorStyle">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border
         					Background="{TemplateBinding Background}"
         					BorderBrush="{TemplateBinding BorderBrush}"
         					BorderThickness="{TemplateBinding BorderThickness}">
                                <syncfusion:SelectorPanel>
                                    <syncfusion:SelectorPanel.Resources>
                                        <Style x:Key="pathStyle" TargetType="{x:Type Shape}">
                                            <Setter Property="StrokeThickness" Value="1"/>
                                            <Setter Property="Stroke" Value="{StaticResource PathStrokeThemeBrush}"/>
                                        </Style>
                                    </syncfusion:SelectorPanel.Resources>
                                    <Rectangle Style="{StaticResource pathStyle}" Stretch="Fill" StrokeDashArray="2, 2"/>
                                    <Line X1="0" X2="0" Y1="0" Y2="0" StrokeThickness="0" Visibility="Collapsed" StrokeDashArray="2, 2" Style="{StaticResource pathStyle}"/>
                                    <syncfusion:DiagramThumb x:Name="PART_TopLeft"  ControlPointType="TopLeftResizer"
         							Style="{StaticResource NullType}"
         							HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <syncfusion:DiagramThumb x:Name="PART_Top" ControlPointType="TopResizer"
         							Style="{StaticResource NullType}"
         							HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <syncfusion:DiagramThumb x:Name="PART_TopRight" ControlPointType="TopRightResizer"
         							Style="{StaticResource NullType}"
         							HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                    <syncfusion:DiagramThumb x:Name="PART_Left" ControlPointType="LeftResizer"
         							Style="{StaticResource NullType}"
         							HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <syncfusion:DiagramThumb x:Name="PART_Right" ControlPointType="RightResizer"
         							Style="{StaticResource NullType}"
         							HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <syncfusion:DiagramThumb x:Name="PART_BottomLeft" ControlPointType="BottomLeftResizer"
         							Style="{StaticResource NullType}"
         							HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <syncfusion:DiagramThumb x:Name="PART_Bottom"  ControlPointType="BottomResizer"
         							Style="{StaticResource NullType}"
         							HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                    <syncfusion:DiagramThumb x:Name="PART_BottomRight" ControlPointType="BottomRightResizer"
         							Style="{StaticResource NullType}"
         							HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

                                    <syncfusion:DiagramThumb Width="0" Height="0" Visibility="Collapsed" ControlPointType="Pivot" x:Name="PART_Pivot"/>
                                    <syncfusion:DiagramThumb Width="0" Height="0" Visibility="Collapsed" ControlPointType="Rotator" x:Name="PART_Rotator"/>
                                </syncfusion:SelectorPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
    </democommon:DemoControl.Resources>

    <Grid>
        <local:CustomDiagram
            x:Name="Diagram"
            Nodes="{Binding Nodes}" PortVisibility="Collapse"
            Connectors="{Binding Connectors}"
            >

            <syncfusion:SfDiagram.SnapSettings>
                <syncfusion:SnapSettings SnapConstraints="None"/>
            </syncfusion:SfDiagram.SnapSettings>
            <syncfusion:SfDiagram.SelectedItems>
                <syncfusion:SelectorViewModel SelectorConstraints="None"/>
            </syncfusion:SfDiagram.SelectedItems>

        </local:CustomDiagram>
    </Grid>
</democommon:DemoControl>
