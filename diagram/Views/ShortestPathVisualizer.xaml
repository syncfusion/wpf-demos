<democommon:DemoControl x:Class="syncfusion.diagramdemo.wpf.Views.ShortestPathVisualizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
               xmlns:local="clr-namespace:syncfusion.diagramdemo.wpf.Views"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:democommon="clr-namespace:syncfusion.demoscommon.wpf;assembly=syncfusion.demoscommon.wpf"
             xmlns:viewmodel="clr-namespace:syncfusion.diagramdemo.wpf.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <democommon:DemoControl.DataContext>
        <viewmodel:ShortestPathVisualizerViewModel/>
    </democommon:DemoControl.DataContext>
    <democommon:DemoControl.Resources>

        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                       Source="/Syncfusion.SfDiagram.WPF;component/Resources/BasicShapes.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Shadow Effect -->
            <DropShadowEffect x:Key="ShadowEffect" 
                      Color="Black" Opacity="0.2" 
                      ShadowDepth="2" BlurRadius="6"/>

            <!-- ← NEW: Step Number Annotation Style -->
            <Style x:Key="StepNumberStyle" TargetType="syncfusion:AnnotationEditor">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="syncfusion:AnnotationEditor">
                            <Border Background="Blue"
                            CornerRadius="12"
                            Padding="8,4"
                            BorderBrush="Blue"
                            BorderThickness="1.5">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.3" 
                                              ShadowDepth="2" BlurRadius="4"/>
                                </Border.Effect>
                                <TextBlock Text="{Binding Path=Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NodeTooltipStyle" TargetType="ToolTip">
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="#2C2C2C" 
                  BorderBrush="#444" 
                  BorderThickness="1" 
                  CornerRadius="4" 
                  Padding="12,8">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.5" 
                                    ShadowDepth="3" BlurRadius="8"/>
                                </Border.Effect>
                                <TextBlock Text="{TemplateBinding Content}" 
                         FontSize="13" 
                         FontWeight="SemiBold"
                         Foreground="White"
                         TextAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Node Style -->
         
            <!-- DASHED CONNECTOR STYLES -->
            <Style x:Key="AnimatedPathConnectorStyle" TargetType="Path">
                <Setter Property="Stroke" Value="#4285F4"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeDashArray" Value="4,2"/>
                <Setter Property="StrokeDashOffset" Value="0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAnimating}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard Name="DashStoryboard">
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                Storyboard.TargetProperty="StrokeDashOffset"
                                From="6" To="0" Duration="0:0:0.5"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="DashStoryboard"/>
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="HoverConnectorStyle" TargetType="Path">
                <Setter Property="Stroke" Value="#4285F4"/>
                <Setter Property="StrokeThickness" Value="2"/>
                <Setter Property="StrokeDashArray" Value="4,2"/>
            </Style>

            <Style x:Key="DefaultConnectorStyle" TargetType="Path">
                <Setter Property="Stroke" Value="#9E9E9E"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
                <Setter Property="StrokeDashArray" Value="4,2"/>
            </Style>

            <!-- SOLID CONNECTOR STYLES -->
            <Style x:Key="AnimatedPathConnectorSolidStyle" TargetType="Path">
                <Setter Property="Stroke" Value="#4285F4"/>
                <Setter Property="StrokeThickness" Value="2"/>
            </Style>

            <Style x:Key="HoverConnectorSolidStyle" TargetType="Path">
                <Setter Property="Stroke" Value="#4285F4"/>
                <Setter Property="StrokeThickness" Value="2"/>
            </Style>

            <Style x:Key="DefaultConnectorSolidStyle" TargetType="Path">
                <Setter Property="Stroke" Value="Black"/>
                <Setter Property="StrokeThickness" Value="1.5"/>
            </Style>

            <!-- ARROW STYLES -->
            <Style x:Key="PathArrowStyle" TargetType="Path">
                <Setter Property="Fill" Value="Black"/>
                <Setter Property="Stroke" Value="Black"/>
            </Style>

            <Style x:Key="HoverArrowStyle" TargetType="Path">
                <Setter Property="Fill" Value="#4285F4"/>
                <Setter Property="Stroke" Value="#4285F4"/>
            </Style>

            <Style x:Key="DefaultArrowStyle" TargetType="Path">
                <Setter Property="Fill" Value="Black"/>
                <Setter Property="Stroke" Value="Black"/>
            </Style>

            <DataTemplate x:Key="viewTemplate">
                <TextBlock Height="15" Width="12" Text="{Binding Path=Content, Mode=TwoWay}" 
       FontSize="10" 
       TextAlignment="Center"
        Background="#4285F4"
       FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
       Foreground="White"/>
            </DataTemplate>

            <SolidColorBrush x:Key="PathStrokeThemeBrush" Color="#FFFFFFFF" />

            <Style x:Key="NullType" TargetType="{x:Type syncfusion:DiagramThumb}">
                <Setter Property="Template" Value="{x:Null}"/>
            </Style>
            <Style x:Key="TopLeftCornerResizerThumpTemplate" TargetType="{x:Type syncfusion:DiagramThumb}">
                <Setter Property="IsTabStop" Value="false"/>
                <Setter Property="Background" Value="Blue"/>
                <Setter Property="Width" Value="25"/>
                <Setter Property="Height" Value="25"/>
                <Setter Property="Margin" Value="0 -5 0 0"/>
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type syncfusion:DiagramThumb}">
                            <Grid >
                                <Rectangle Fill="Transparent"/>

                                <Border   Height="2" HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
           						VerticalAlignment="{TemplateBinding VerticalAlignment}"  Margin="0 -3 0 0"
           						x:Name="PART_ReseizerThumb" CornerRadius="7" 
           						Background="{TemplateBinding Background}"
           						BorderBrush="{TemplateBinding BorderBrush}"
           						BorderThickness="0" />
                                <Rectangle  x:Name="PART_ResizerBorder" HorizontalAlignment="{TemplateBinding HorizontalAlignment}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
           						VerticalAlignment="{TemplateBinding VerticalAlignment}" Fill="Blue" Stroke="Blue"  StrokeThickness="1"
           						Margin="7"/>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style TargetType="{x:Type syncfusion:Selector}" x:Key="CustomSelectorStyle">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate>
                            <Border
           					Background="{TemplateBinding Background}"
           					BorderBrush="{TemplateBinding BorderBrush}"
           					BorderThickness="{TemplateBinding BorderThickness}">
                                <syncfusion:SelectorPanel>
                                    <syncfusion:SelectorPanel.Resources>
                                        <Style x:Key="pathStyle" TargetType="{x:Type Shape}">
                                            <Setter Property="StrokeThickness" Value="1"/>
                                            <Setter Property="Stroke" Value="{StaticResource PathStrokeThemeBrush}"/>
                                        </Style>
                                    </syncfusion:SelectorPanel.Resources>
                                    <Rectangle Style="{StaticResource pathStyle}" Stretch="Fill" StrokeDashArray="2, 2"/>
                                    <Line X1="0" X2="0" Y1="0" Y2="0" StrokeThickness="0" Visibility="Collapsed" StrokeDashArray="2, 2" Style="{StaticResource pathStyle}"/>
                                    <syncfusion:DiagramThumb x:Name="PART_TopLeft"  ControlPointType="TopLeftResizer"
           							Style="{StaticResource NullType}"
           							HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                    <syncfusion:DiagramThumb x:Name="PART_Top" ControlPointType="TopResizer"
           							Style="{StaticResource NullType}"
           							HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                    <syncfusion:DiagramThumb x:Name="PART_TopRight" ControlPointType="TopRightResizer"
           							Style="{StaticResource NullType}"
           							HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                    <syncfusion:DiagramThumb x:Name="PART_Left" ControlPointType="LeftResizer"
           							Style="{StaticResource NullType}"
           							HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                    <syncfusion:DiagramThumb x:Name="PART_Right" ControlPointType="RightResizer"
           							Style="{StaticResource NullType}"
           							HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <syncfusion:DiagramThumb x:Name="PART_BottomLeft" ControlPointType="BottomLeftResizer"
           							Style="{StaticResource NullType}"
           							HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                    <syncfusion:DiagramThumb x:Name="PART_Bottom"  ControlPointType="BottomResizer"
           							Style="{StaticResource NullType}"
           							HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                    <syncfusion:DiagramThumb x:Name="PART_BottomRight" ControlPointType="BottomRightResizer"
           							Style="{StaticResource NullType}"
           							HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

                                    <syncfusion:DiagramThumb Width="0" Height="0" Visibility="Collapsed" ControlPointType="Pivot" x:Name="PART_Pivot"/>
                                    <syncfusion:DiagramThumb Width="0" Height="0" Visibility="Collapsed" ControlPointType="Rotator" x:Name="PART_Rotator"/>
                                </syncfusion:SelectorPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            
            <Style TargetType="syncfusion:Node">
                <Setter Property="ToolTipService.InitialShowDelay" Value="0"/>
                <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
                <Setter Property="ToolTip">
                    <Setter.Value>
                        <ToolTip Content="{Binding TooltipText}" 
              Style="{StaticResource NodeTooltipStyle}"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- ← Hide tooltip when TooltipText is null -->
                    <DataTrigger Binding="{Binding TooltipText}" Value="{x:Null}">
                        <Setter Property="ToolTip" Value="{x:Null}"/>
                    </DataTrigger>
                    <!-- ← Hide tooltip when TooltipText is empty -->
                    <DataTrigger Binding="{Binding TooltipText}" Value="">
                        <Setter Property="ToolTip" Value="{x:Null}"/>
                    </DataTrigger>
                    <!-- ← Hide tooltip when IsHover is false -->
                    <DataTrigger Binding="{Binding IsHover}" Value="False">
                        <Setter Property="ToolTip" Value="{x:Null}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

        </ResourceDictionary>
       

    </democommon:DemoControl.Resources>
    <Grid>


        <!-- Diagram with Custom Selector -->
        <Grid >
            <!-- ← Apply SelectorStyle directly here -->
            <local:Diagram x:Name="Diagram" Loaded="Diagram_Loaded_1" 
                               DefaultConnectorType="Line"
                               Nodes="{Binding NodesCollection}"
                               Connectors="{Binding ConnectorsCollection}"
                               Background="White"
                              >

                <!--<local:Diagram.Constraints>
                    <syncfusion:GraphConstraints>
                        Default,
                     Zoomable,
                     Pannable
                    </syncfusion:GraphConstraints>
                </local:Diagram.Constraints>-->

                <local:Diagram.HorizontalRuler>
                    <syncfusion:Ruler Visibility="Collapsed"/>
                </local:Diagram.HorizontalRuler>

                <local:Diagram.VerticalRuler>
                    <syncfusion:Ruler Visibility="Collapsed"/>
                </local:Diagram.VerticalRuler>
                
                <local:Diagram.SnapSettings>
                    <syncfusion:SnapSettings SnapConstraints="None"/>
                </local:Diagram.SnapSettings>

                <local:Diagram.ScrollSettings>
                    <syncfusion:ScrollSettings />
                </local:Diagram.ScrollSettings>
                <local:Diagram.PageSettings>
                    <syncfusion:PageSettings ShowPageBreaks="False" 
                                          PageBackground="White"/>
                </local:Diagram.PageSettings>
            </local:Diagram>

            <!-- OVERLAY: Directed Graph Toggle Button -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                 Margin="0,20,0,0" Background="White"
                 BorderBrush="#E0E0E0" BorderThickness="1"
                 CornerRadius="20" Padding="16,8"
                 Effect="{StaticResource ShadowEffect}">
                <StackPanel Orientation="Horizontal">
                    <ToggleButton IsChecked="{Binding IsDirected}" 
                               Width="50" Height="28" Cursor="Hand"
                               BorderThickness="0" FontWeight="Bold" FontSize="11">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border" Background="#BDBDBD" 
                                                 CornerRadius="14" Padding="3">
                                                <Grid>
                                                    <Ellipse x:Name="thumb" Width="22" Height="22"
                                                          Fill="White" HorizontalAlignment="Left"
                                                          Effect="{StaticResource ShadowEffect}"/>
                                                    <TextBlock x:Name="text" Text="OFF" 
                                                            FontSize="9" FontWeight="Bold"
                                                            Foreground="White"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,6,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#34A853"/>
                                                    <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter TargetName="text" Property="Text" Value="ON"/>
                                                    <Setter TargetName="text" Property="HorizontalAlignment" Value="Left"/>
                                                    <Setter TargetName="text" Property="Margin" Value="6,0,0,0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                    <TextBlock Text="Directed Graph" Foreground="Black" FontSize="14" FontWeight="Medium"
                            VerticalAlignment="Center" Margin="12,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>


    </Grid>
</democommon:DemoControl>
