<democommon:DemoControl x:Class="syncfusion.diagramdemo.wpf.Views.VennDiagram"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:democommon="clr-namespace:syncfusion.demoscommon.wpf;assembly=syncfusion.demoscommon.wpf"   
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:syncfusion.diagramdemo.wpf.Views"
             xmlns:viewmodel="clr-namespace:syncfusion.diagramdemo.wpf.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <democommon:DemoControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Syncfusion.SfDiagram.Wpf;component/Resources/BasicShapes.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Path" x:Key="DecoratorHollowStyle">
                <Setter Property="Stroke" Value="Green"/>
                <Setter Property="Fill" Value="Green"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="Stretch" Value="Fill"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeDashCap" Value="Round"/>
            </Style>
            <Style TargetType="syncfusion:AnnotationEditor">
                <Setter Property="FontSize" Value="12"/>
            </Style>

        </ResourceDictionary>

    </democommon:DemoControl.Resources>
    
    <democommon:DemoControl.DataContext>
        <viewmodel:VennDiagramViewModel/>
    </democommon:DemoControl.DataContext>
    <Grid>

        <syncfusion:SfDiagram
            x:Name="Diagram" Loaded="Diagram_Loaded" PortVisibility="Collapse" Tool="ZoomPan"
            Nodes="{Binding Nodes}"
            Connectors="{Binding Connectors}" >

            <syncfusion:SfDiagram.PageSettings>
                <syncfusion:PageSettings
            PageWidth="1100" PageHeight="700"
            ShowPageBreaks="False"
            PageBackground="White"/>
            </syncfusion:SfDiagram.PageSettings>

            <syncfusion:SfDiagram.SnapSettings>
                <syncfusion:SnapSettings SnapConstraints="None"/>
            </syncfusion:SfDiagram.SnapSettings>

            <syncfusion:SfDiagram.ScrollSettings>
                <syncfusion:ScrollSettings />
            </syncfusion:SfDiagram.ScrollSettings>
        </syncfusion:SfDiagram>
    </Grid>
</democommon:DemoControl>
