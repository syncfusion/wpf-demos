<democommon:DemoControl
    x:Class="syncfusion.dropdowndemos.wpf.SmartComboBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:democommon="clr-namespace:syncfusion.demoscommon.wpf;assembly=syncfusion.demoscommon.wpf"
    xmlns:interaction="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:syncfusion.dropdowndemos.wpf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <democommon:DemoControl.DataContext>
        <local:FoodViewModel/>
    </democommon:DemoControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,100,100">
            <TextBlock Text="Smart Filtering" FontSize="14" FontWeight="Bold" Margin="10,10,10,6" />
            <Syncfusion:ComboBoxAdv Grid.Row="1" Width="250" Height="24" DefaultText="Select Items..." Margin="10,8,10,10" IsEditable="True" x:Name="combobox" ItemsSource="{Binding Foods}" DisplayMemberPath="Name">
                <interaction:Interaction.Triggers>
                    <interaction:EventTrigger EventName="KeyUp">
                        <local:ComboBoxFilterInfo/>
                    </interaction:EventTrigger>
                </interaction:Interaction.Triggers>
            </Syncfusion:ComboBoxAdv>
        </StackPanel>
    </ScrollViewer>

</democommon:DemoControl>