<sfchrome:SfChromelessWindow x:Class="syncfusion.layoutdemos.wpf.TearOffWindowCustomizeDemo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:syncfusion.layoutdemos.wpf"
        xmlns:sfchrome="clr-namespace:Syncfusion.Windows.Controls;assembly=Syncfusion.SfChromelessWindow.Wpf"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:viewModel="clr-namespace:syncfusion.layoutdemos.wpf.ViewModel"
        WindowType="Tabbed"
        mc:Ignorable="d"
        Title="TearOffWindowCustomizeDemo" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <sfchrome:SfChromelessWindow.DataContext>
        <viewModel:TearOffWindowCustomizationViewModel />
    </sfchrome:SfChromelessWindow.DataContext>
    <Grid>
        <sfchrome:SfTabControl x:Name="MainTabControl"
                        ItemsSource="{Binding sfabItems}"
                        AllowDragDrop="True"
                        EnableNewTabButton="False"
                        NewWindowCreating="MainTabControl_NewWindowCreating">
            <sfchrome:SfTabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" />
                </DataTemplate>
            </sfchrome:SfTabControl.ItemTemplate>
            <sfchrome:SfTabControl.ContentTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="7*" />
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="12">
                            <TextBlock Text="{Binding Content}" FontWeight="Bold" TextWrapping="Wrap" FontSize="14" Margin="0,10,0,5" />
                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,15,0,0" />
                        </StackPanel>
                        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                            <local:WindowTypeSelectionView />
                        </ScrollViewer>
                    </Grid>
                </DataTemplate>
            </sfchrome:SfTabControl.ContentTemplate>
        </sfchrome:SfTabControl>
    </Grid>
</sfchrome:SfChromelessWindow>
