<UserControl x:Class="syncfusion.layoutdemos.wpf.WindowTypeSelectionView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:syncfusion.layoutdemos.wpf"
        mc:Ignorable="d">
    <!-- StackPanel uses RelativeSource to bind to the Window's DataContext -->
    <StackPanel VerticalAlignment="Top" 
                DataContext="{Binding DataContext.WindowTypeSelector, RelativeSource={RelativeSource AncestorType=Window}}">
        <!-- Title -->
        <TextBlock Text="Select Window Type" 
            FontSize="14" 
            FontWeight="Bold" 
            Margin="0,0,0,12"
            Foreground="#333"/>

        <!-- Description -->
        <TextBlock Text="Choose how this panel should appear when torn off:" 
            FontSize="11" 
            Margin="0,0,0,16"
            Foreground="#666"
            TextWrapping="Wrap"/>
        
        <!-- Label -->
        <TextBlock Text="Window Type:" 
                   FontSize="11" 
                   FontWeight="SemiBold" 
                   Margin="0,0,0,8"
                   Foreground="#333"/>
        
        <!-- ComboBox - Binds to WindowTypeSelector.SelectedWindowType -->
        <ComboBox x:Name="WindowTypeComboBox"
                  ItemsSource="{Binding WindowTypes}"
                  SelectedItem="{Binding SelectedWindowType}"
                  HorizontalAlignment="Left"
                  Width="175"
                  Padding="10,8"
                  FontSize="11"
                  Background="White"/>
    </StackPanel>
</UserControl>
