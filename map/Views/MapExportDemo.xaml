<democommon:DemoControl
        x:Class="syncfusion.mapdemos.wpf.MapExportDemo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:interact="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:democommon="clr-namespace:syncfusion.demoscommon.wpf;assembly=syncfusion.demoscommon.wpf"
        xmlns:local="clr-namespace:syncfusion.mapdemos.wpf"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        Title="MapExportDemo" 
        Height="auto" 
        Width="auto" 
        OptionsPosition="Right"
        OptionsSize="Auto">

    <interact:Interaction.Behaviors>
        <local:MapsExportBehavior />
    </interact:Interaction.Behaviors>
    <democommon:DemoControl.DataContext>
        <local:OpenStreetMapsViewModel />
    </democommon:DemoControl.DataContext>

    <Grid>
        <!--Geometry Map View -->
        <syncfusion:SfMap x:Name="geometryMap" 
                          Margin="20"  
                          EnablePan="True"
                          EnableZoom="True">
            <syncfusion:SfMap.Layers>
                <syncfusion:ShapeFileLayer MarkerHorizontalAlignment="Far"
                                           Markers="{Binding Models}"
                                           Uri="/syncfusion.mapdemos.wpf;component/Assets/Map/Data/world1.shp">
                    <syncfusion:ShapeFileLayer.MarkerTemplate>
                        <DataTemplate>
                            <Grid Margin="-10,-25,0,0">
                                <Canvas>
                                    <Image Height="25" Source="/syncfusion.mapdemos.wpf;component\Assets\Map\Images\pin.png" />
                                </Canvas>
                            </Grid>
                        </DataTemplate>
                    </syncfusion:ShapeFileLayer.MarkerTemplate>
                    <syncfusion:ShapeFileLayer.ShapeSettings>
                        <syncfusion:ShapeSetting ShapeStrokeThickness="1"/>
                    </syncfusion:ShapeFileLayer.ShapeSettings>
                </syncfusion:ShapeFileLayer>
            </syncfusion:SfMap.Layers>
        </syncfusion:SfMap>

        <!--OSM Map View -->
        <syncfusion:SfMap x:Name="osmMap"
                          Margin="20"
                          Visibility="Collapsed"
                          EnablePan="True"
                          EnableZoom="True"
                          ZoomLevel="2"
                          IsManipulationEnabled="True">
            <syncfusion:SfMap.Layers>
                <syncfusion:ImageryLayer LayerType="OSM" Markers="{Binding Models}">
                    <syncfusion:ImageryLayer.MarkerTemplate>
                        <DataTemplate>
                            <Grid Margin="-10,-25,0,0">
                                <Canvas>
                                    <Image Height="25" Source="/syncfusion.mapdemos.wpf;component\Assets\Map\Images\pin.png" />
                                </Canvas>
                            </Grid>
                        </DataTemplate>
                    </syncfusion:ImageryLayer.MarkerTemplate>
                    <syncfusion:ImageryLayer.MarkerToolTipSettings>
                        <syncfusion:ToolTipSetting ValuePath="Name" />
                    </syncfusion:ImageryLayer.MarkerToolTipSettings>
                </syncfusion:ImageryLayer>
            </syncfusion:SfMap.Layers>
        </syncfusion:SfMap>
    </Grid>

    <democommon:DemoControl.Options>
        <WrapPanel Orientation="Vertical">
            <StackPanel>
                <Label Margin="-4,0,0,0"
                       VerticalAlignment="Center"
                       Content="Map Type"
                       FontWeight="Bold" />
                <ComboBox Name="MapTypeComboBox"
                          Width="150"
                          Margin="-2,0,0,0"
                          Padding="10,5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          SelectedIndex="0">
                    <ComboBoxItem>Geometry</ComboBoxItem>
                    <ComboBoxItem>OSM</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <StackPanel Margin="0,10,0,0">
                <Label Margin="-4,0,0,0"
                       VerticalAlignment="Center"
                       Content="Export Type"
                       FontWeight="Bold" />
                <ComboBox Name="ExportTypeComboBox"
                          Width="150"
                          Margin="-2,0,0,0"
                          Padding="10,5"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          SelectedIndex="0">
                    <ComboBoxItem>PNG</ComboBoxItem>
                    <ComboBoxItem>JPEG</ComboBoxItem>
                    <ComboBoxItem>SVG</ComboBoxItem>
                </ComboBox>
            </StackPanel>

            <StackPanel Margin="0,10,0,0">
                <Label Margin="-4,0,0,0"
                       VerticalAlignment="Center"
                       Content="File Name"
                       FontWeight="Bold" />
                <TextBox Name="FileNameTextBox"
                         Width="150"
                         Margin="0"
                         Padding="0,4"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Text="Maps">
                </TextBox>
            </StackPanel>

            <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center">
                <Button Name="ExportButton"
                        Width="80"
                        Height="30"
                        Padding="10,5"
                        Content="Export"
                        ToolTip="Export image to Downloads folder"
                        FontWeight="Medium"
                        Style="{DynamicResource WPFPrimaryButtonStyle}">
                </Button>
            </StackPanel>
        </WrapPanel>
    </democommon:DemoControl.Options>
</democommon:DemoControl>