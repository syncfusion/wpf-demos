<democommon:DemoControl
        x:Class="syncfusion.treegriddemos.wpf.TreeGridPagingDemo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:syncfusion.treegriddemos.wpf"
        xmlns:democommon="clr-namespace:syncfusion.demoscommon.wpf;assembly=syncfusion.demoscommon.wpf"
        xmlns:interactivity="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
        syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
        Background="#FFFFFF" >

    <democommon:DemoControl.Resources>
        <local:SelfRelationalPagingView x:Key="selfRelationalPagingView" />
    </democommon:DemoControl.Resources>

    <democommon:DemoControl.Options>
        <StackPanel>
            <TextBlock x:Name="textBlock1"
                       Margin="5"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="Bold"
                       Text="TreeGrid View Type:" />
            <ComboBox x:Name="treeGridViewTypeComboBox"
                      Margin="5"
                      Height="25"
                      Width="150"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      SelectedIndex="0">
                      <ComboBoxItem Content="Self Relational View" />
                      <ComboBoxItem Content="Nested Collection View" />
            </ComboBox>

            <TextBlock x:Name="textBlock2"
                       Margin="5"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       FontSize="12"
                       FontWeight="Bold"
                       Text="DataPager Orientation:" />
            <ComboBox x:Name="orientationComboBox"
                      Margin="5"
                      Height="25"
                      Width="150"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      SelectedIndex="0">
                      <ComboBoxItem Content="Horizontal" />
                      <ComboBoxItem Content="Vertical" />
            </ComboBox>

            <Button x:Name="expandButton"
                    Margin="5"
                    Height="25"
                    Width="150"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Expand All Nodes" />
            <Button x:Name="collapseButton"
                    Margin="5"
                    Height="25"
                    Width="150"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Content="Collapse All Nodes" />
        </StackPanel>
    </democommon:DemoControl.Options>
    
    <interactivity:Interaction.Behaviors>
        <local:TreeGridPagingBehavior/>
    </interactivity:Interaction.Behaviors>

    <Grid>
        <Frame x:Name="treeGridArea"
               Content="{StaticResource selfRelationalPagingView}"
               NavigationUIVisibility="Hidden" />
    </Grid>
</democommon:DemoControl>