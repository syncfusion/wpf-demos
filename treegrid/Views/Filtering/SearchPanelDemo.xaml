<democommon:DemoControl
    x:Class="syncfusion.treegriddemos.wpf.SearchPanelDemo"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:democommon="clr-namespace:syncfusion.demoscommon.wpf;assembly=syncfusion.demoscommon.wpf"
    xmlns:interactivity="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:syncfusion.treegriddemos.wpf"
    xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
    xmlns:syncfusionskin="clr-namespace:Syncfusion.SfSkinManager;assembly=Syncfusion.SfSkinManager.WPF"
    syncfusionskin:SfSkinManager.Theme="{syncfusionskin:SkinManagerExtension ThemeName=Windows11Light}"
    Background="#FFFFFF"
    DataContext="{DynamicResource viewmodel}"
    Foreground="#444444">

    <democommon:DemoControl.Resources>
        <local:EmployeeInfoViewModel x:Key="viewmodel" />
    </democommon:DemoControl.Resources>

    <Grid x:Name="Separator" DataContext="{StaticResource viewmodel}">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="/syncfusion.treegriddemos.wpf;component/Resources/TreeGridSearch.xaml" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Grid.Resources>

        <syncfusion:SfTreeGrid
            x:Name="treeGrid"
            Margin="5"
            AllowEditing="True"
            AllowSorting="True"
            AutoExpandMode="RootNodesExpanded"
            AutoGenerateColumns="False"
            ChildPropertyName="Children"
            
            ColumnSizer="Star"
            ItemsSource="{Binding PersonDetails}"
            NavigationMode="Cell">
            <syncfusion:SfTreeGrid.Columns>
                <syncfusion:TreeGridTextColumn HeaderText="First Name" MappingName="FirstName" />
                <syncfusion:TreeGridTextColumn HeaderText="Last Name" MappingName="LastName" />
                <syncfusion:TreeGridNumericColumn HeaderText="Employee ID" MappingName="ID" NumberDecimalDigits="0" />
                <syncfusion:TreeGridMaskColumn HeaderText="Contact Number" MappingName="ContactNumber" Mask="(999)-999-9999" />
                <syncfusion:TreeGridTextColumn HeaderText="City" MappingName="City" />
                <syncfusion:TreeGridCurrencyColumn HeaderText="Salary" MappingName="Salary" CurrencySymbol="$" />
                <syncfusion:TreeGridDateTimeColumn MappingName="DOJ" />
            </syncfusion:SfTreeGrid.Columns>
        </syncfusion:SfTreeGrid>

        <local:TreeGridSearchControl
            x:Name="searchControl"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            TreeGrid="{Binding ElementName=treeGrid}"
            Visibility="Visible" />
    </Grid>

    <interactivity:Interaction.Behaviors>
        <local:TreeGridSearchDemoBehavior />
    </interactivity:Interaction.Behaviors>
</democommon:DemoControl>
